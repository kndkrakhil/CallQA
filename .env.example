# Call QA Scoring - Environment Configuration

# Primary LLM: Groq Free Tier (14,400 requests/day - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM: Google AI Studio (1,500 requests/day - https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face Token for pyannote speaker diarization (https://huggingface.co)
HF_TOKEN=your_huggingface_token_here

# Faster-Whisper Model Settings (tiny, base, small, medium)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
